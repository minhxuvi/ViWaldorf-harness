# Public base URL (used for Google OAuth callback fallback)
APP_URL=http://localhost:3000

# Google OAuth 2.0 SSO (Web application client, scopes: openid profile email)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional editorial token for posting official replies & updating feedback development status
FEEDBACK_API_TOKEN=
FEEDBACK_EDITORIAL_EMAIL=banbientap@viwaldorf.vn
